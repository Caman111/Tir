package main 
import "fmt"
func main() {
    const usdToEur = 0.85
    const usdToRub = 90.0

    const eurToRub = usdToRub / usdToEur
   
    fmt.Print("Курсы: \n")
    fmt.Print("1 USD = %.2f EUR\n", usdToEur)
    fmt.Print("1 USD = %.2f RUB\n", usdToRub)
    fmt.Print("1 EUR = %.2f RUB\n", eurToRub)
   }